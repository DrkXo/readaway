name: CI Quality Gate

on:
  push:
    branches: [ main, master, dev ]
  pull_request:
    branches: [ main, master, dev ]

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  quality:
    name: Code Quality & Tests
    runs-on: ubuntu-latest
    timeout-minutes: 30

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Setup Java (JDK 21)
        uses: actions/setup-java@v4
        with:
          distribution: 'temurin'
          java-version: '21'
          cache: 'gradle'

      - name: Cache FVM, Pub & Build Runner Dependencies
        uses: actions/cache@v4
        with:
          path: |
            ~/.fvm/versions
            ~/fvm/versions
            ~/.pub-cache
            **/.dart_tool/build
          key: ${{ runner.os }}-build-cache-${{ hashFiles('.fvmrc') }}-${{ hashFiles('**/pubspec.lock') }}
          restore-keys: |
            ${{ runner.os }}-build-cache-${{ hashFiles('.fvmrc') }}-
            ${{ runner.os }}-build-cache-

      - name: Install FVM CLI
        run: |
          curl -fsSL https://fvm.app/install.sh | bash
          echo "$HOME/fvm/bin" >> $GITHUB_PATH
          echo "$HOME/.fvm/bin" >> $GITHUB_PATH

      - name: Setup Flutter SDK via FVM
        run: |
          export PATH="$HOME/fvm/bin:$HOME/.fvm/bin:$PATH"
          fvm install
          fvm use
          echo "$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin" >> $GITHUB_PATH
          echo "$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin" >> $GITHUB_PATH

      - name: Setup Melos & Bootstrap
        run: |
          export PATH="$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin:$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin:$HOME/.pub-cache/bin:$PATH"
          dart pub global activate melos
          echo "$HOME/.pub-cache/bin" >> $GITHUB_PATH
          melos bootstrap

      - name: Generate Code (Codegen)
        run: |
          export PATH="$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin:$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin:$HOME/.pub-cache/bin:$PATH"
          melos run codegen

      - name: Check Code Formatting
        run: |
          export PATH="$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin:$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin:$HOME/.pub-cache/bin:$PATH"
          melos run format

      - name: Static Code Analysis
        run: |
          export PATH="$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin:$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin:$HOME/.pub-cache/bin:$PATH"
          melos run analyze

      - name: Run Package & App Tests
        run: |
          export PATH="$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin:$GITHUB_WORKSPACE/.fvm/flutter_sdk/bin/cache/dart-sdk/bin:$HOME/.pub-cache/bin:$PATH"
          melos run test
