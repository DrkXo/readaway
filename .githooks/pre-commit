#!/usr/bin/env bash
# Readaway Git Hook: pre-commit
# Enforces code formatting on staged Dart files, prevents secret leaks, and blocks conflict markers.

set -e

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}[pre-commit] Running sanity checks on staged changes...${NC}"

# 1. Check for unresolved merge conflict markers
CONFLICT_FILES=$(git diff --cached --name-only -S"<<<<<<< " 2>/dev/null || true)
if [ -n "$CONFLICT_FILES" ]; then
  echo -e "${RED}[pre-commit] Error: Unresolved merge conflict markers found in staged files:${NC}"
  echo "$CONFLICT_FILES"
  exit 1
fi

# 2. Check for accidental staging of secrets and credentials
SECRET_PATTERNS='(\.env$|\.env\..+|\.key$|\.keystore$|\.jks$|id_rsa$|id_ed25519$|service-account.*\.json$)'
STAGED_SECRETS=$(git diff --cached --name-only | grep -E "$SECRET_PATTERNS" 2>/dev/null || true)
if [ -n "$STAGED_SECRETS" ]; then
  echo -e "${RED}[pre-commit] Error: Attempting to commit potentially sensitive files:${NC}"
  echo "$STAGED_SECRETS"
  echo -e "${YELLOW}Please unstage these files before committing or verify they are safe.${NC}"
  exit 1
fi

# 3. Check for oversized staged files (>5MB)
LARGE_FILES=$(git diff --cached --name-only | while read -r file; do
  if [ -f "$file" ]; then
    size=$(stat -c%s "$file" 2>/dev/null || stat -f%z "$file" 2>/dev/null || echo 0)
    if [ "$size" -gt 5242880 ]; then
      echo "$file ($((size / 1048576))MB)"
    fi
  fi
done)

if [ -n "$LARGE_FILES" ]; then
  echo -e "${YELLOW}[pre-commit] Warning: Large files staged (>5MB):${NC}"
  echo "$LARGE_FILES"
fi

# 4. Check Dart formatting on staged .dart files
STAGED_DART_FILES=$(git diff --cached --name-only --diff-filter=d | grep '\.dart$' 2>/dev/null || true)

if [ -n "$STAGED_DART_FILES" ]; then
  echo -e "${BLUE}[pre-commit] Checking Dart formatting on staged files...${NC}"

  # Determine dart command (via FVM if available, or system dart)
  if [ -f ".fvm/flutter_sdk/bin/dart" ]; then
    DART_CMD=".fvm/flutter_sdk/bin/dart"
  elif [ -d ".fvm/flutter_sdk/bin/cache/dart-sdk/bin" ]; then
    DART_CMD=".fvm/flutter_sdk/bin/cache/dart-sdk/bin/dart"
  elif command -v fvm >/dev/null 2>&1; then
    DART_CMD="fvm dart"
  elif command -v dart >/dev/null 2>&1; then
    DART_CMD="dart"
  else
    echo -e "${YELLOW}[pre-commit] Dart SDK not found in path or .fvm, skipping dart format check.${NC}"
    DART_CMD=""
  fi

  if [ -n "$DART_CMD" ]; then
    UNFORMATTED_FILES=""
    for file in $STAGED_DART_FILES; do
      if [ -f "$file" ]; then
        if ! $DART_CMD format --output=none --set-exit-if-changed "$file" >/dev/null 2>&1; then
          UNFORMATTED_FILES="$UNFORMATTED_FILES $file"
        fi
      fi
    done

    if [ -n "$UNFORMATTED_FILES" ]; then
      echo -e "${RED}[pre-commit] Formatting error! The following files need formatting:${NC}"
      for file in $UNFORMATTED_FILES; do
        echo -e "   - ${file}"
      done
      echo -e "${YELLOW}Run 'dart format <file>' or 'melos run format' and re-stage your changes.${NC}"
      exit 1
    fi
  fi
fi

echo -e "${GREEN}[pre-commit] All pre-commit checks passed!${NC}"
exit 0
