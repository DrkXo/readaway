#!/usr/bin/env bash
# ReadAway Git Hook: pre-push
# Lightweight gate: performs fast static analysis and branch protection checks before push.

set -e

# ANSI color codes
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}[pre-push] Running lightweight sanity checks before pushing...${NC}"

# Check current branch
CURRENT_BRANCH=$(git branch --show-current 2>/dev/null || echo "")

echo -e "${BLUE}[pre-push] Current branch: ${CURRENT_BRANCH:-detached}${NC}"

# Run static analysis across workspace
echo -e "${BLUE}[pre-push] Running static analysis across workspace packages...${NC}"

if [ -f ".fvm/flutter_sdk/bin/dart" ]; then
  MELOS_CMD=".fvm/flutter_sdk/bin/dart run melos"
elif command -v fvm >/dev/null 2>&1; then
  MELOS_CMD="fvm dart run melos"
elif command -v melos >/dev/null 2>&1; then
  MELOS_CMD="melos"
elif command -v dart >/dev/null 2>&1; then
  MELOS_CMD="dart run melos"
else
  echo -e "${YELLOW}[pre-push] Melos/Dart not found in path, skipping pre-push analysis.${NC}"
  exit 0
fi

if ! $MELOS_CMD run analyze; then
  echo -e "\n${RED}[pre-push] Static analysis failed! Please fix analysis issues before pushing.${NC}"
  echo -e "${YELLOW}Run 'melos run analyze' locally to inspect and fix errors.${NC}"
  exit 1
fi

echo -e "${GREEN}[pre-push] Pre-push verification passed! Proceeding with push.${NC}"
exit 0
