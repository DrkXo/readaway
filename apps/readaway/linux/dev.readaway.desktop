[Desktop Entry]
Name=ReadAway
GenericName=eBook & Document Reader
Comment=eBook, HTML, Comic, and Text Document Reader
Exec=readaway %F
Icon=readaway
Terminal=false
Type=Application
Categories=Office;Viewer;
StartupNotify=true
StartupWMClass=dev.readaway
MimeType=application/epub+zip;application/pdf;application/vnd.comicbook+zip;application/x-cbz;application/vnd.comicbook-rar;application/x-cbr;application/x-cbt;application/x-cb7;text/plain;text/html;application/xhtml+xml;text/markdown;text/x-markdown;
